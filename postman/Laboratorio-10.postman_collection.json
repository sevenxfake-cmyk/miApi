{
  "info": {
    "name": "SENATI Lab 10 - Inventario JWT",
    "description": "Importar en Postman. Ejecutar registro o usar admin existente, luego login; el token se guarda automáticamente. Para crear productos, configure categoryId con una categoría existente. DELETE requiere Administrador.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3006"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Registro almacenero",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Laboratorio\",\n  \"email\": \"laboratorio@example.com\",\n  \"password\": \"CambiarClave2026\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "02 - Login (guarda token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login correcto', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"laboratorio@example.com\",\n  \"password\": \"CambiarClave2026\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "03 - GET productos sin token (espera 401)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "04 - Perfil con JWT",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "05 - GET productos con JWT",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "06 - Crear producto (guarda ID)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('productId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Producto Lab10\",\n  \"descripcion\": \"Prueba de seguridad JWT\",\n  \"precio\": 15,\n  \"categoria_id\": {{categoryId}},\n  \"proveedor_id\": null\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "07 - Editar producto",
      "request": {
        "method": "PUT",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Producto Lab10 actualizado\",\n  \"descripcion\": \"Prueba PUT\",\n  \"precio\": 18,\n  \"categoria_id\": {{categoryId}},\n  \"proveedor_id\": null\n}"
        },
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      }
    },
    {
      "name": "08 - Eliminar producto (solo admin)",
      "request": {
        "method": "DELETE",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      }
    }
  ]
}
